doctype html
html
  head
    title Asset Management
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css')
    link(rel='stylesheet', href='/app.css')
  body
    .app-shell
      aside.sidebar
        a.brand(href='/')
          span Asset Management
        p.sidebar-label WORKSPACE
        nav.sidebar-nav
          a(href='/') Overview
          a(href='/assets') Assets
          a(href='/stock') Stock view
          a(href='/issue') Issue asset
          a(href='/return') Return asset
        p.sidebar-label MASTERS
        nav.sidebar-nav
          a(href='/employees') Employees
          a(href='/categories') Categories
        .sidebar-footer
      main.content-area
        block content
    script(src='https://code.jquery.com/jquery-3.7.1.min.js')
    script(src='https://cdn.datatables.net/2.1.8/js/dataTables.js')
    script(src='https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js')
    script(src='/app.js')
